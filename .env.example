# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string, database name in the path:
# mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DATABASE_URL=

# Buy Me a Coffee username (the footer button is hidden when empty)
NEXT_PUBLIC_BUYMEACOFFEE_USERNAME=

# Optional: canonical origin (defaults to https://creedoflife.com)
NEXT_PUBLIC_SITE_URL=
